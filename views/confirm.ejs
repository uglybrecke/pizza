<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>confirm order</title>
</head>
<body>
    <h1>Thank you for your order <%= order.fname %>!</h1>
    <h2>Order Summary:</h2>
    <p>Name: <%= order.fname %> <%= order.lname %></p>
    <p>Email: <%= order.email %></p>
    <p>Method: <%= order.delivery %></p>
    <p>Size: <%= order.size %></p>
    <p>Toppings: <%= order.toppings %></p>
    <p>Order Comments: <%= order.comment %></p>

    <a href="/">Return home!</a>
</body>
</html>